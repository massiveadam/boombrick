#!/bin/sh
# Opens (or rejoins) the coding agents' tmux session on the server: type
# `pocket` in the terminal. Settings are in config.sh.
#
#   pocket            connect to POCKET_SSH
#   pocket key        show this device's public key, to add to the server's
#                     ~/.ssh/authorized_keys
#
# It uses the dbclient shipped here (dropbear), with a key made on first
# use in home/.ssh, and goes through Tailscale when its Port has it on
# (userspace Tailscale routes nothing by itself).
DIR="$(cd "$(dirname "$0")" && pwd)"
. "$DIR/config.sh"
export HOME="$DIR/home"
KEY=$HOME/.ssh/id_dropbear
mkdir -p "$HOME/.ssh"
if [ ! -f "$KEY" ]; then
	"$DIR/bin/dropbearkey" -t ed25519 -f "$KEY" > /dev/null 2>&1 || { echo "couldn't make a key" >&2; exit 1; }
	echo "Made this device's SSH key. Add it to the server's ~/.ssh/authorized_keys:"
	"$DIR/bin/dropbearkey" -y -f "$KEY" | grep '^ssh-'
	echo
	[ "$1" = key ] && exit 0
fi
if [ "$1" = key ]; then
	"$DIR/bin/dropbearkey" -y -f "$KEY" | grep '^ssh-'
	exit 0
fi
case "$POCKET_SSH" in "" | you@your-server)
	echo "Set POCKET_SSH (user@server) in $DIR/config.sh first." >&2; exit 1 ;;
esac
hostport=${POCKET_SSH#*@} # host, or host/port
host=${hostport%%/*}
port=22
case "$hostport" in */*) port=${hostport#*/} ;; esac
TS="$(dirname "$DIR")/tailscale"
if [ -x "$TS/tailscale" ] && [ -S /tmp/rgsp-tailscale/tailscaled.sock ]; then
	exec "$DIR/bin/dbclient" -i "$KEY" -J "$TS/tailscale --socket=/tmp/rgsp-tailscale/tailscaled.sock nc $host $port" \
		-t "$POCKET_SSH" "tmux new -As $POCKET_SESSION"
fi
exec "$DIR/bin/dbclient" -i "$KEY" -t "$POCKET_SSH" "tmux new -As $POCKET_SESSION"
