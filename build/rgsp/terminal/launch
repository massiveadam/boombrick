#!/bin/sh
# Starts the terminal (TermSP) on the RG SP from plorpOS's Ports shelf.
# Menu quits.
PAK_DIR="$(cd "$(dirname "$0")" && pwd)"
PORTS="$(dirname "$PAK_DIR")"
cd "$PAK_DIR" || exit 1
mkdir -p logs
[ -f config.sh ] || cp config.example.sh config.sh
. ./config.sh

export LD_LIBRARY_PATH="$PAK_DIR/lib:$LD_LIBRARY_PATH"
export TERM=xterm-256color
export PATH="$PAK_DIR:$PORTS/boombrick/bin:$PORTS/tailscale:$PATH"
export HOME="${HOME:-$PAK_DIR}"
# With Tailscale on (its own Port), reach the tailnet through its proxy.
if [ -f "$PORTS/tailscale/ts.sh" ] && sh "$PORTS/tailscale/ts.sh" status 2>/dev/null | grep -q Running; then
	eval "$(sh "$PORTS/tailscale/ts.sh" env)"
fi

shell=/bin/sh
for s in /usr/bin/bash /bin/bash; do [ -x "$s" ] && shell=$s && break; done
SHELL=$shell ./termsp -k -s "$FONT_SIZE" -f fonts/Hack-Regular.ttf -b fonts/Hack-Bold.ttf > logs/termsp.txt 2>&1
exit 0
