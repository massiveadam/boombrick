 int handleJoyButtons(SDL_Event *ev) {
+    /* The RG SP's built-in pad, as plorpOS's SDL reports it: b0 A, b1 B,
+     * b2 Y, b3 X, b4 L1, b5 R1, b6 Select, b7 Start, b8 Menu, b9 L2, b10 R2.
+     * L2 and R2 do nothing. */
     switch (ev->type) {
         case SDL_JOYBUTTONDOWN:
             switch (ev->jbutton.button) {
-                case 0:  // B button (b0)
-                    KEYB_SimulateKey(SDLK_BACKSPACE, STATE_DOWN);
-                    break;
-                case 1:  // A button (b1)
+                case 0:  // A: type the key under the cursor
                     KEYB_ClickKey();
                     break;
-                case 2:  // X button (b2)
+                case 1:  // B: backspace
+                    KEYB_SimulateKey(SDLK_BACKSPACE, STATE_DOWN);
+                    break;
+                case 2:  // Y: show or hide the keyboard
                     KEYB_Toggle();
                     return 1;
-                    break;
-                case 3:  // Y button (b3)
+                case 3:  // X: keyboard to the top or bottom
                     KEYB_SwitchLocation();
                     break;
-                case 4:  // Left Shoulder (L1) (b4)
+                case 4:  // L1: shift while held
                     KEYB_Shift(1);
                     break;
-                case 5:  // Right Shoulder (R1) (b5)
+                case 5:  // R1: latch a modifier (Ctrl, Alt...)
                     KEYB_ToggleMod();
                     break;
-                case 6:  // Back button (b6)
+                case 6:  // Select: tab
                     KEYB_SimulateKey(SDLK_TAB, STATE_DOWN);
                     break;
-                case 7:  // Start button (b7)
+                case 7:  // Start: enter
                     KEYB_SimulateKey(SDLK_RETURN, STATE_DOWN);
                     break;
-                case 8:  // Guide button (Home) (b8)
+                case 8:  // Menu: quit
                     return -1;
-                    break;
-                case 9:  // Left Stick Button (L3) (b9)
-                    break;
-                case 10:  // Right Stick Button (R3) (b10)
-                    break;
             }
             break;
 
